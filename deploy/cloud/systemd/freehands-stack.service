[Unit]
Description=FreeHands stack (docker compose)
Documentation=https://github.com/Lynxifyy/FreeHands/tree/main/deploy/cloud
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/freehands/deploy/cloud
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
