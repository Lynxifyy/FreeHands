# Public hostname Caddy will obtain a certificate for (DNS A/AAAA -> this host).
FREEFHANDS_DOMAIN=canvas.example.com
# Image tag: latest, a release (1.31.0), or a sha-<short> build.
FREEFHANDS_VERSION=latest

# Optional. Leave blank to let the entrypoint generate and persist them in the
# freehands-state volume. Set them to share one key across replicas/restarts.
SESSION_API_KEY=
OH_SECRET_KEY=
# Keep false on a public host: the UI then asks for the session key.
AGENT_CANVAS_ALLOW_LAN_SESSION_KEY=false

# Optional coding-agent credentials for Complex Code (OpenCode).
OPENCODE_API_KEY=
# The full contents of ~/.local/share/opencode/auth.json, if you use one.
OPENCODE_AUTH_CONTENT=

# Optional: enables the bundled Mobilebox live-screen tools.
MOBILESANDBOX_API_KEY=
